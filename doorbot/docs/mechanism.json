  "checks": [
    {
      "check": "offset_removes_dead_centre",
      "pass": true,
      "detail": "included angle at the hinge axis is 28.9 deg when shut and 118.9 deg wide open. It never reaches 0 or 180 deg, which are the two collinear dead centres where no tension makes any torque"
    },
    {
      "check": "arm_never_collapses",
      "pass": true,
      "detail": "worst-case moment arm over the whole swing is 41.7 mm (peak 70.1 mm), after subtracting the 2 mm mounting tolerance. A straight chord with the exit on the closed-door plane would instead go to 0 mm at 0 deg"
    },
    {
      "check": "drum_holds_travel",
      "pass": true,
      "detail": "101.3 mm of travel = 5.20 turns at an effective 3.1 mm winding radius needs 8.1 mm of grooved drum; drum_width is 10 mm"
    },
    {
      "check": "cable_strength",
      "pass": true,
      "detail": "cable rated 680 N against a hardware-limited maximum tension of 151 N (safety factor 4.5, 3.0 required)"
    },
    {
      "check": "torque_margin",
      "pass": true,
      "detail": "worst torque margin is 2.98x at 90 deg (2.0x required, against the worst-case 0.82 N.m hinge friction and 0.5 deg of frame out-of-plumb)"
    },
    {
      "check": "no_stall_angle",
      "pass": true,
      "detail": "the drive holds and moves the door at every angle"
    },
    {
      "check": "close_time_sane",
      "pass": true,
      "detail": "full close from 90 deg takes 21.0 s at the quasi-static operating point (the TT motor's 65.4 mN.m and 207 RPM at 5 V cap mechanical power near 0.35 W, so the 5 s sweep of a hydraulic closer is not available at any gear ratio)"
    },
    {
      "check": "energy_cap",
      "pass": true,
      "detail": "the leaf arrives carrying 0.60 J - 0.100 J of cable-driven kinetic energy plus 0.50 J of magnet work over the last 15 mm - against the A156.19 1.69 J cap (leaf inertia 11.14 kg.m2)"
    },
    {
      "check": "latch_period_reported",
      "pass": true,
      "detail": "the last 10 deg takes 1.64 s under cable drive alone; A156.19's 1.5 s latch period is written for a sprung hydraulic closer with a latch bolt to retract. This design has no latch bolt: the magnets take over at about 1 deg and snap the leaf shut, so the energy check above is the meaningful limit and this figure is reported, not asserted"
    },
    {
      "check": "magnet_holds_closed",
      "pass": true,
      "detail": "70.0 N of magnet pull at the as-built 2.0 mm gap (>= 40 N required to keep a 40 kg leaf shut against a draught)"
    },
    {
      "check": "magnet_takes_over",
      "pass": true,
      "detail": "at 1 deg - a 16 mm air gap at the latch edge - the magnets alone make 2.56 N.m against 0.85 N.m of resistance, so the last few millimetres are magnet-driven and the cable never has to work near a dead centre"
    },
    {
      "check": "stage1_teeth",
      "pass": true,
      "detail": "stage-1 pinion root stress 3.93 MPa against the 5.5 MPa cyclic in-plane allowable (gears print flat, so tooth load stays in the layer plane)"
    },
    {
      "check": "stage2_teeth",
      "pass": true,
      "detail": "stage-2 pinion root stress 4.84 MPa against 5.5 MPa"
    },
    {
      "check": "anchor_cable_eye",
      "pass": true,
      "detail": "the anchor's cable eye carries the tension in double shear across 100 mm2 of material, 1.51 MPa against the 5.0 MPa across-layer allowable; the eye prints with its axis flat so the load does not peel layers apart"
    },
    {
      "check": "idler_pin_shear",
      "pass": true,
      "detail": "the 4 mm steel idler pin sees 6.0 MPa in double shear (120 MPa allowable for plain steel, and the load path is a steel pin rather than a printed cantilever)"
    },
    {
      "check": "anchor_screws",
      "pass": true,
      "detail": "3 x M4.0 screws hold the sheave to the door stile in shear: 4.0 MPa on the screw cross-sections"
    },
    {
      "check": "unit_outside_swept_volume",
      "pass": true,
      "detail": "an ordinary butt hinge puts the pivot axis in the door's push face, so over 0..90 deg the leaf sweeps only the quadrant at negative polar angles. The whole unit sits at x 0..36 mm, y 0..50 mm - positive in both - so nothing it contains is ever in the leaf's path, and the door still opens fully by hand with the power off"
    },
    {
      "check": "cable_stays_push_side",
      "pass": true,
      "detail": "both cable ends sit clear of the leaf's push face - the anchor eye 25 mm off the face, the exit 40 mm off the closed plane - so the straight run between them stays on the push side at every angle and can never foul the leaf or wrap the hinge"
    },
    {
      "check": "unit_within_rebate",
      "pass": true,
      "detail": "the shell is 50 mm across the jamb depth and stands 36 mm out into the opening on 0 mm feet, both inside the 51 mm rebate of a 4-9/16 in jamb"
    },
    {
      "check": "exit_reachable_on_nose",
      "pass": true,
      "detail": "the exit at (60, 40) mm sits in the integral nose, a 20 x 18 mm fin that carries the chute 24 mm past the cover to x = 60 mm. The exit has to reach out along the door to keep the moment arm up; the nose is the cheapest way to do that without making the whole shell that deep"
    },
    {
      "check": "nose_bending",
      "pass": true,
      "detail": "the nose root sees 3.63 N.m of bending from 151 N at its tip: 3.02 MPa against the 5.0 MPa across-layer allowable, which is the right allowable because the shell prints with its open face up and the nose therefore grows along the layer axis"
    },
    {
      "check": "guide_loss_accounted",
      "pass": true,
      "detail": "the cable turns 50 deg through the exit chute, so the door only receives 1/1.140 of the drum tension: 133 N delivered from 151 N wound. Every printed part above is checked at the wound figure"
    },
    {
      "check": "anchor_withdrawal",
      "pass": true,
      "detail": "the 25 mm standoff turns 151 N of tension into 3.78 N.m on the anchor base; over a 40 mm screw span that is 95 N of withdrawal per screw, against 400 N allowed for a #8 screw 25 mm into a solid-core stile"
    },
    {
      "check": "current_budget",
      "pass": true,
      "detail": "motor current is chopped in hardware at 1.0 A by the DRV8833 breakout's 0.2 ohm sense resistors, taken from the USB 5 V rail at the driver, never through the T-Display board"
    }
  ],
